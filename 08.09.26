<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
     Podaj imie <input type="text" id="name">
     <input type="button" value="przeslij" onclick="witaj()">
     <div id="wynik">!!! TU BEDZIE WYNIK !!!</div>
    <script>
        function witaj(){
            imie = document.getElementById("name").value 
            // alert(imie)
            // document.write("witaj "+imie)
            document.getElementById("wynik").innerHTML="witaj "+imie
        }
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    Podaj x <input type="number" id="x"> <br>    
    Podaj y <input type="number" id="y"> 
    <input type="button" value="iloczyn" onclick="iloczyn()">
    <input type="button" value="suma" onclick="suma()">
    <div id="wynik"></div>
    <script>
        function suma(){
            x = document.getElementById("x").value
            y = document.getElementById("y").value
            suma = document.getElementById("wynik").innerHTML = x + y
        }

        function iloczyn(){
            x = document.getElementById("x").value
            y = document.getElementById("y").value
            iloczyn = document.getElementById("wynik").innerHTML = x * y
        }
    </script>
</body>
</html>
